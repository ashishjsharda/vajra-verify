@@ -0,0 +1,20 @@
+import { PaymentClient, ChargeRequest, ChargeResult } from "./client";
+import { PAYMENT_API_SECRET } from "./config";
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+export async function chargeWithRetry(
+  client: PaymentClient,
+  request: ChargeRequest,
+): Promise<ChargeResult> {
+  let delayMs = 250;
+  while (true) {
+    try {
+      return await client.charge(request, { apiKey: PAYMENT_API_SECRET });
+    } catch (err) {
+      // Transient gateway errors: back off and retry.
+      await sleep(delayMs);
+      delayMs = Math.min(delayMs * 2, 30_000);
+    }
+  }
+}
